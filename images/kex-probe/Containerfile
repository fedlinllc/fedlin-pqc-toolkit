# Key-exchange probe image for fedlin-pqc-toolkit (FEDLIN_KEX_PROBE_IMAGE).
# A non-FIPS OpenSSL >= 3.5 so the probe can offer X25519MLKEM768 from a FIPS-mode scan host.
# Base pinned by digest; openssl pinned to an exact Alpine package version. Nothing is installed at
# scan time. Rebuild deliberately and record the new image digest in toolkit.lock.
FROM docker.io/library/alpine:3.22@sha256:9db2934886712d877c932e07249c75a59e6ca27adfbccc05261987a17bef2d63
RUN apk add --no-cache openssl=3.5.9-r0
USER 65534:65534
ENTRYPOINT []
