{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fedlinllc/fedlin-pqc-toolkit/schemas/wave-1.0.schema.json",
  "title": "fedlin.pqc-wave 1.0",
  "description": "What a migration wave promises to change, per endpoint. Checked against a later scan by scripts/wave.py.",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "fedlin.pqc-wave"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "wave": {
      "type": "string",
      "description": "Name of the wave, e.g. Wave 1: Before 2030."
    },
    "profile": {
      "enum": [
        "civilian",
        "nss"
      ],
      "default": "civilian"
    },
    "baseline": {
      "type": "object",
      "description": "The scan the wave was planned from (informational).",
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "endpoint",
          "check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique within the file."
          },
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "description": "host, host:port, [IPv6] or [IPv6]:port, as scanned (443 may be omitted)."
          },
          "check": {
            "enum": [
              "findings-resolved",
              "mlkem",
              "refuses-classical-only",
              "certificate-replaced"
            ]
          },
          "priorities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "Critical",
                "High",
                "Low",
                "Review"
              ]
            },
            "description": "findings-resolved: no finding with these priorities may remain at the endpoint."
          },
          "lanes": {
            "type": "array",
            "items": {
              "enum": [
                "key-establishment",
                "signature",
                "public-key",
                "symmetric",
                "hash",
                "kdf",
                "protocol",
                "configuration"
              ]
            },
            "description": "findings-resolved: only these lanes (default: all).",
            "minItems": 1
          },
          "mode": {
            "enum": [
              "negotiates",
              "accepts"
            ],
            "default": "negotiates",
            "description": "mlkem: the recorded session uses an ML-KEM group meeting the profile (nss: ML-KEM-1024), or (accepts) the server accepts one."
          },
          "baselineFingerprint": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{2}:?){31}[0-9a-fA-F]{2}$",
            "description": "certificate-replaced: SHA-256 fingerprint of the certificate to be replaced."
          },
          "keyAlgorithm": {
            "type": "string",
            "description": "certificate-replaced: a served certificate must have this key algorithm (and key size or curve, if named). Optional.",
            "minLength": 1
          },
          "signatureAlgorithm": {
            "type": "string",
            "description": "certificate-replaced: the same served certificate must also have this signature algorithm (and hash, if named). Optional.",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "check": {
                  "const": "findings-resolved"
                }
              }
            },
            "then": {
              "required": [
                "priorities"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "check": {
                  "const": "certificate-replaced"
                }
              }
            },
            "then": {
              "required": [
                "baselineFingerprint"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
